# STOBOOK Environment Variables Configuration

# Supabase
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Telegram Bot & Mini App
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
# Bot username without "@". Used by the login screen to offer a direct link to the
# Mini App when it is opened outside Telegram and no initData is available.
VITE_TELEGRAM_BOT_USERNAME="stobookbot"

# Web Push (VAPID)
VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgSnfckjBJuBKr3qBUYIHBQFLXYp5Nksh8U"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:support@stobook.ru"

# Maps (osm | yandex | google)
MAP_PROVIDER="osm"
MAP_API_KEY=""

# ─── Реквизиты оператора (обязательно для production) ───────────────────────
# Используются в Пользовательском соглашении, Политике обработки персональных
# данных и Согласии на обработку ПДн. Без них документы публиковать нельзя:
# согласие по ст. 9 ФЗ-152 должно содержать реальные реквизиты оператора.
#
# Реквизиты дублируются в src/config/legal.ts. Переменные VITE_* имеют приоритет,
# но правки в файле надёжнее: они попадают в сборку независимо от деплоя.
VITE_LEGAL_NAME="ООО «Название компании»"
VITE_LEGAL_INN="1234567890"
VITE_LEGAL_KPP="123456789"
VITE_LEGAL_OGRN="1234567890123"
VITE_LEGAL_ADDRESS="Российская Федерация, г. Новосибирск, ул. Примерная, д. 1"
VITE_LEGAL_CLAIMS_ADDRESS="Российская Федерация, г. Новосибирск, ул. Примерная, д. 1"
VITE_LEGAL_EMAIL="support@example.ru"
VITE_LEGAL_PERSONAL_DATA_EMAIL="privacy@example.ru"
VITE_LEGAL_PHONE="+7 (383) 000-00-00"
VITE_LEGAL_SITE_URL="https://stobook.ru"

# Payments (demo | yookassa | tinkoff)
# Провайдер "demo" БРОСАЕТ ОШИБКУ в production и никогда не подтверждает
# оплату: до подключения ЮKassa или Т-Банка платежи работать не будут.
PAYMENT_PROVIDER="demo"
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# App URL
APP_URL="http://localhost:3000"
PORT="3000"

# Session signing (required in production, min 32 chars)
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-characters"

# Storage backend: memory (dev only) | postgres
# Production refuses to start with STOBOOK_DB=memory.
STOBOOK_DB="memory"

# PostgreSQL connection string from Supabase -> Project Settings -> Database.
# The booking engine uses transaction-level advisory locks, so the transaction
# pooler (port 6543, pgbouncer=true) is NOT supported.
# Preferred: the direct connection (db.<ref>.supabase.co:5432).
# If your network has no IPv6 (most CI/Vercel setups), use the SESSION pooler
# on port 5432 instead - it keeps one backend connection per client and is safe.
DATABASE_URL="postgresql://postgres.your-ref:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Telegram ids with the SUPER_ADMIN role, e.g. "111111111,222222222".
# The list is synchronised on every login: a listed account is promoted, and an
# account removed from the list is demoted back to service owner or customer.
# While the variable is empty nobody is touched, so a misconfigured deployment
# cannot lock the platform out.
ADMIN_TELEGRAM_IDS=""

# Protects POST /api/cron/reminders (the caller sends "Authorization: Bearer $CRON_SECRET").
# Vercel Hobby plans cannot run cron jobs, so the schedule lives in
# .github/workflows/reminder-cron.yml and calls this endpoint.
CRON_SECRET="change-me-to-a-random-cron-secret"

# Fallback Telegram chat for reminders when a customer has no linked Telegram account
DEMO_TELEGRAM_CHAT_ID=""

GEMINI_API_KEY=""

